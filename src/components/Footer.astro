---
import { site, siblings } from "../data/site";
import { copyFor, localePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__mark" href={localePath(locale, "/")}>
        <img src="/brand/logo-512.png" width="24" height="24" alt="" aria-hidden="true" />
        <span>beatrax</span>
      </a>
      <p class="footer__tag">{t.meta.tagline}</p>
      <p class="footer__license">
        <a href={site.licenseUrl} target="_blank" rel="noopener">{t.footer.license}</a>
        <span class="footer__sep">·</span>
        <span>{t.footer.sourceAvailable}</span>
      </p>
    </div>

    <div class="footer__col">
      <h2 class="footer__h">{t.footer.product}</h2>
      <a href={site.releases} target="_blank" rel="noopener">{t.nav.download}</a>
      <a href={site.repo} target="_blank" rel="noopener">{t.cta.repo}</a>
      <a href={site.specRepo} target="_blank" rel="noopener">{t.cta.spec}</a>
      <a href={localePath(locale, "/licence")}>{t.nav.licence}</a>
      <a href={localePath(locale, "/colophon")}>{t.footer.colophon}</a>
    </div>

    <div class="footer__col">
      <h2 class="footer__h">{t.footer.repos}</h2>
      <a href={site.repo} target="_blank" rel="noopener">beatrax</a>
      <a href={site.specRepo} target="_blank" rel="noopener">spec</a>
      <a href={site.websiteRepo} target="_blank" rel="noopener">website</a>
    </div>

    <div class="footer__col">
      <h2 class="footer__h">{t.footer.org}</h2>
      <a href={site.githubOrg} target="_blank" rel="noopener">GitHub</a>
      <a href={site.by.url} target="_blank" rel="noopener">{site.by.name}</a>
    </div>

    <div class="footer__col footer__col--wide">
      <h2 class="footer__h">{t.footer.alsoFrom}</h2>
      {
        siblings.map((s) => (
          <a class="sib" href={s.url} target="_blank" rel="noopener">
            <b>{s.label}</b>
            <span>{t.footer[s.key as "happklaar" | "lemonfiber"]}</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="container footer__base">
    <span>© {year} {site.by.name}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-tint);
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-9);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 0.8fr) 1.2fr;
    gap: var(--space-6);
  }
  .footer__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
  }
  .footer__tag {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: 0.92rem;
    max-width: 34ch;
  }
  .footer__license {
    margin-top: var(--space-4);
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .footer__license a:hover {
    color: var(--accent);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.9rem;
  }
  .footer__col a {
    color: var(--text-muted);
    transition: color 0.14s ease;
  }
  .footer__col a:hover {
    color: var(--accent);
  }
  .footer__h {
    font-size: var(--size-eyebrow);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-faint);
    font-weight: var(--weight-semibold);
    margin-bottom: 0.3rem;
  }
  .sib {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .sib span {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--text-faint);
  }
  .sib:hover b {
    color: var(--accent);
  }
  .footer__base {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-faint);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .footer__base a:hover {
    color: var(--accent);
  }
  .footer__sep {
    color: var(--text-faint);
  }
  @media (max-width: 1000px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer__col--wide {
      grid-column: span 3;
    }
  }
  @media (max-width: 720px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__col--wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
