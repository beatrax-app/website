---
import {
  copyFor,
  localePath,
  stripLocale,
  LOCALES,
  LOCALE_LABELS,
  type Locale,
} from "../i18n";

interface Props {
  locale: Locale;
  active?: string;
}

const { locale, active } = Astro.props;
const t = copyFor(locale);
const here = stripLocale(Astro.url.pathname);

const links = [
  { key: "features", href: `${localePath(locale, "/")}#features`, label: t.nav.features },
  { key: "audience", href: localePath(locale, "/audience"), label: t.nav.audience },
  { key: "formats", href: localePath(locale, "/formats"), label: t.nav.formats },
  { key: "privacy", href: localePath(locale, "/privacy"), label: t.nav.privacy },
  { key: "community", href: localePath(locale, "/community"), label: t.nav.community },
  { key: "faq", href: localePath(locale, "/faq"), label: t.nav.faq },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={localePath(locale, "/")}>
      <img src="/brand/logo-512.png" width="26" height="26" alt="" aria-hidden="true" />
      <span class="nav__name">beatrax</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            class:list={["nav__link", { "is-active": active === l.key }]}
            href={l.href}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__end">
      <div class="langswitch" role="group" aria-label={t.nav.language}>
        {
          LOCALES.map((l) => (
            <a
              class:list={["langswitch__opt", { "is-active": l === locale }]}
              href={localePath(l, here)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? "true" : undefined}
              data-set-locale={l}
            >
              {l.toUpperCase()}
              <span class="visually-hidden"> — {LOCALE_LABELS[l]}</span>
            </a>
          ))
        }
      </div>

      <button class="themetoggle" type="button" aria-label={t.nav.theme} data-theme-toggle>
        <svg class="themetoggle__sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
          </g>
        </svg>
        <svg class="themetoggle__moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path
            d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
            fill="currentColor"></path>
        </svg>
      </button>

      <a class="btn btn--primary nav__cta" href={localePath(locale, "/download")}>
        {t.nav.download}
      </a>

      <button
        class="navtoggle"
        type="button"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="nav-panel"
        data-nav-toggle
      >
        <span class="navtoggle__bar" aria-hidden="true"></span>
        <span class="navtoggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="navpanel" id="nav-panel" hidden data-nav-panel>
    <nav class="container navpanel__inner" aria-label={t.nav.menu}>
      {
        links.map((l) => (
          <a class="navpanel__link" href={l.href}>
            {l.label}
          </a>
        ))
      }
      <a class="btn btn--primary navpanel__cta" href={localePath(locale, "/download")}>
        {t.nav.download}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  // Theme toggle. Writes the same key the pre-paint script in Base reads, so a
  // reload keeps the choice without a flash of the wrong theme.
  (() => {
    const btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const explicit = root.getAttribute("data-theme");
      const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
      const current = explicit ?? (prefersLight ? "paper" : "ink");
      const next = current === "ink" ? "paper" : "ink";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("bx-theme", next);
      } catch {}
    });
  })();

  (() => {
    const toggle = document.querySelector("[data-nav-toggle]");
    const panel = document.querySelector("[data-nav-panel]");
    if (!toggle || !panel) return;

    const setOpen = (open) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      document.documentElement.classList.toggle("nav-open", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    // Growing past the breakpoint reveals the desktop nav; leaving the panel
    // open would stack a second copy of the same links underneath it.
    window.matchMedia("(min-width: 1121px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  })();

  // Choosing a language explicitly pins it, which also switches off the
  // one-shot detection redirect for good.
  document.querySelectorAll("[data-set-locale]").forEach((el) => {
    el.addEventListener("click", () => {
      try {
        localStorage.setItem("bx-locale", el.getAttribute("data-set-locale") || "en");
      } catch {}
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: nowrap;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-tight);
    font-size: 1.05rem;
  }
  /* The row needs ~1037px in English and ~1053px in Dutch before it would
     wrap; collapsing at 1120px keeps headroom for longer labels in either. */
  .nav__links {
    display: flex;
    gap: var(--space-5);
    margin-inline-start: var(--space-4);
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .nav__link {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.14s ease;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--text);
  }
  .nav__end {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .langswitch {
    display: flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .langswitch__opt {
    padding: 0.3rem 0.55rem;
    font-size: 0.72rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    color: var(--text-faint);
    transition: background-color 0.14s ease, color 0.14s ease;
  }
  .langswitch__opt:hover {
    color: var(--text);
  }
  .langswitch__opt.is-active {
    background: var(--surface-2);
    color: var(--text);
  }
  .themetoggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: color 0.14s ease, border-color 0.14s ease;
  }
  .themetoggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .themetoggle__sun {
    display: none;
  }
  :root[data-theme="paper"] .themetoggle__sun {
    display: block;
  }
  :root[data-theme="paper"] .themetoggle__moon {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="ink"]) .themetoggle__sun {
      display: block;
    }
    :root:not([data-theme="ink"]) .themetoggle__moon {
      display: none;
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .navtoggle {
    display: none;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0;
    place-items: center;
    align-content: center;
    justify-items: center;
    gap: 5px;
  }
  .navtoggle__bar {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }
  .navtoggle[aria-expanded="true"] .navtoggle__bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .navtoggle[aria-expanded="true"] .navtoggle__bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .navpanel {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .navpanel__inner {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
  }
  .navpanel__link {
    padding: var(--space-3) 0;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    font-size: 1rem;
  }
  .navpanel__link:hover {
    color: var(--text);
  }
  .navpanel__cta {
    justify-content: center;
    margin-top: var(--space-3);
  }

  @media (max-width: 1120px) {
    .nav__links {
      display: none;
    }
    .navtoggle {
      display: grid;
    }
    .nav__cta {
      display: none;
    }
  }
  @media (min-width: 1121px) {
    .navpanel {
      display: none;
    }
  }
</style>
