---
// Every release, rendered from the GitHub Releases API. The bodies are
// generated by git-cliff from the commit log at tag time, so there is nothing
// here that can disagree with what shipped — no file to forget to update.
//
// Release bodies are `### Group` headings and `- item` bullets. Anything else
// is passed through as a paragraph rather than dropped, so an unusual release
// note degrades to plain text instead of vanishing.
//
// Only the three inline marks release notes actually use are rendered; the rest
// of Markdown is escaped and shown literally rather than pulling a parser in for
// text the release pipeline generates.
import { getSiteData } from "../lib/github";
import { site } from "../data/site";
import { copyFor, type Locale } from "../i18n";
import { releaseDate } from "../lib/format";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copyFor(locale);
const data = await getSiteData();

interface Block {
  heading: string;
  items: string[];
}

function parseBody(body: string | undefined): { blocks: Block[]; prose: string[] } {
  const blocks: Block[] = [];
  const prose: string[] = [];
  let current: Block | null = null;
  // Bullets wrap across lines in the older hand-written notes; a continuation
  // rejoins its bullet instead of being dropped on the floor.
  let open: string[] | null = null;

  for (const raw of (body ?? "").split("\n")) {
    const line = raw.trim();
    if (!line) {
      open = null;
      continue;
    }

    if (line.startsWith("#")) {
      if (current?.items.length) blocks.push(current);
      current = { heading: line.replace(/^#+\s*/, ""), items: [] };
      open = null;
      continue;
    }

    const bullet = /^[-*]\s+(.*)$/.exec(line);
    if (bullet) {
      const target = current ? current.items : prose;
      target.push(bullet[1]);
      open = target;
      continue;
    }

    if (open?.length) {
      open[open.length - 1] += ` ${line}`;
      continue;
    }
    if (!current) prose.push(line);
  }
  if (current?.items.length) blocks.push(current);
  return { blocks, prose };
}

const ESCAPES: Record<string, string> = {
  "&": "&amp;",
  "<": "&lt;",
  ">": "&gt;",
  '"': "&quot;",
};

function inline(text: string): string {
  return text
    .replace(/[&<>"]/g, (c) => ESCAPES[c])
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(
      /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener">$1</a>',
    );
}

const releases = data.releases.map((r) => ({ ...r, ...parseBody(r.body) }));
const totalChanges = releases.reduce(
  (n, r) => n + r.blocks.reduce((k, b) => k + b.items.length, 0),
  0,
);

// "Breaking" leads visually wherever it appears — it is the one heading a
// reader must not skim past.
const toneFor = (heading: string) =>
  /break|remove/i.test(heading)
    ? "warn"
    : /feature|added|new/i.test(heading)
      ? "accent"
      : "plain";
---

<article class="doc">
  <header class="section doc__head">
    <div class="container">
      <p class="eyebrow">{t.changelog.eyebrow}</p>
      <h1 class="doc__h">{t.changelog.title}</h1>
      <p class="lead doc__lead">{t.changelog.lead}</p>

      {
        releases.length > 0 && (
          <div class="cl__stats">
            <span class="cl__stat">
              <b class="mono">{releases.length}</b> {t.changelog.statReleases}
            </span>
            <span class="cl__stat">
              <b class="mono">{totalChanges}</b> {t.changelog.statChanges}
            </span>
            <span class="cl__stat">
              <b class="mono">{releases[0].tag}</b> {t.changelog.statLatest}
            </span>
          </div>
        )
      }
    </div>
  </header>

  <div class="container cl__body">
    {
      releases.length === 0 ? (
        <p class="cl__empty">
          {t.changelog.unavailable}{" "}
          <a href={`${site.repo}/releases`} target="_blank" rel="noopener">
            {t.changelog.onGitHub}
          </a>
        </p>
      ) : (
        <ol class="cl__list">
          {releases.map((r, i) => (
            <li class:list={["cl__rel", { "is-latest": i === 0 }]} id={r.tag}>
              <div class="cl__rail">
                <span class="cl__dot" aria-hidden="true" />
              </div>
              <div class="cl__card card">
                <header class="cl__head">
                  <div class="cl__title">
                    <a class="cl__tag mono" href={r.url} target="_blank" rel="noopener">
                      {r.tag}
                    </a>
                    {i === 0 && <span class="cl__latest">{t.changelog.latest}</span>}
                  </div>
                  <time class="cl__date" datetime={r.publishedAt}>
                    {releaseDate(r.publishedAt, locale)}
                  </time>
                </header>

                {r.name && r.name !== r.tag && <p class="cl__name">{r.name}</p>}
                {r.prose.map((p) => (
                  <p class="cl__prose" set:html={inline(p)} />
                ))}

                {r.blocks.map((b) => (
                  <section class:list={["cl__block", `is-${toneFor(b.heading)}`]}>
                    <h3 class="cl__block-h">
                      {b.heading}
                      <span class="cl__count mono">{b.items.length}</span>
                    </h3>
                    <ul class="cl__items">
                      {b.items.map((it) => (
                        <li set:html={inline(it)} />
                      ))}
                    </ul>
                  </section>
                ))}

                {r.assets.length > 0 && (
                  <p class="cl__assets mono">
                    {r.assets.filter((a) => a.platform && a.platform !== "checksums").length}{" "}
                    {t.changelog.downloads}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }

    <p class="cl__source">
      <a href={`${site.repo}/releases`} target="_blank" rel="noopener">
        {t.changelog.onGitHub} →
      </a>
    </p>
  </div>
</article>

<style>
  .doc__head {
    padding-bottom: var(--space-4);
    background: radial-gradient(
      110% 60% at 20% -20%,
      color-mix(in srgb, var(--accent) 10%, transparent),
      transparent 60%
    );
  }
  .doc__h {
    font-size: var(--size-display-xl);
    margin-top: var(--space-3);
    max-width: 22ch;
  }
  .doc__lead {
    margin-top: var(--space-4);
    max-width: 62ch;
  }
  .cl__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .cl__stat {
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  .cl__stat b {
    font-size: 1.35rem;
    color: var(--accent);
    margin-right: 0.35rem;
  }
  .cl__body {
    padding-bottom: var(--space-9);
  }
  .cl__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
    max-width: 900px;
  }
  .cl__rel {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--space-4);
  }
  .cl__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-5);
  }
  .cl__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
    flex: none;
  }
  .is-latest .cl__dot {
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-bg);
  }
  .cl__rail::after {
    content: "";
    flex: 1;
    width: 1px;
    background: var(--border);
    margin-top: var(--space-3);
  }
  .cl__rel:last-child .cl__rail::after {
    display: none;
  }
  .cl__card {
    padding: var(--space-5);
  }
  .is-latest .cl__card {
    border-color: color-mix(in srgb, var(--accent) 38%, var(--border));
  }
  .cl__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .cl__title {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .cl__tag {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
  }
  .cl__latest {
    font-size: 0.68rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    background: var(--accent);
    color: var(--bx-ink);
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
  }
  .cl__date {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .cl__name {
    margin-top: var(--space-2);
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .cl__prose {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .cl__block {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .cl__block.is-warn {
    border-top-color: color-mix(in srgb, var(--warn) 50%, transparent);
  }
  .cl__block.is-accent {
    border-top-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .cl__block-h {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text-faint);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .is-warn .cl__block-h {
    color: var(--warn);
  }
  .is-accent .cl__block-h {
    color: var(--accent);
  }
  .cl__count {
    font-size: 0.7rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 0.05em 0.45em;
  }
  .cl__items {
    margin-top: var(--space-3);
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .cl__items li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .cl__items :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.35em;
  }
  .cl__items :global(strong) {
    color: var(--text);
    font-weight: var(--weight-semibold);
  }
  .cl__items :global(a) {
    color: var(--accent);
  }
  .cl__items li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .cl__assets {
    margin-top: var(--space-4);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .cl__empty {
    margin-top: var(--space-7);
    color: var(--text-muted);
  }
  .cl__empty a,
  .cl__source a {
    color: var(--accent);
  }
  .cl__source {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }
  @media (max-width: 620px) {
    .cl__rel {
      grid-template-columns: 1fr;
    }
    .cl__rail {
      display: none;
    }
  }
</style>
