---
import Base from "../layouts/Base.astro";
import DocPage from "../components/DocPage.astro";
import CoverageTable from "../components/CoverageTable.astro";
import { docFor } from "../i18n/pages";

const doc = docFor("en", "community")!;
---

<Base locale="en" active="community" title={doc.title} description={doc.lead}>
  <DocPage doc={doc}>
    <CoverageTable locale="en" />
  </DocPage>
</Base>
